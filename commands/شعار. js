const axios = require("axios");
const fs = require("fs");

module.exports = {
  config: {
    name: "شعار",
    aliases: ["logo", "لوغو", "ephoto", "effect"],
    version: "1.0",
    author: "روريتا",
    prefix: true,
    category: "UTILITY",
    description: "إنشاء شعار نصي",
    guide: "{pn} نص"
  },

  onStart: async function({ api, event, args }) {
    if (!args[0]) return api.sendMessage("اكتبي النص للشعار.", event.threadID);

    const text = args.join(" ");
    api.sendMessage("✨ جاري إنشاء الشعار…", event.threadID);

    try {
      const img = await axios.get(`https://api.popcat.xyz/pooh?text=${encodeURIComponent(text)}`, { responseType: "arraybuffer" });

      fs.writeFileSync("logo.png", Buffer.from(img.data));
      api.sendMessage(
        { body: "✔️ شعارك جاهز:", attachment: fs.createReadStream("logo.png") },
        event.threadID,
        () => fs.unlinkSync("logo.png")
      );
    } catch {
      api.sendMessage("❌ فشل إنشاء الشعار.", event.threadID);
    }
  }
};
